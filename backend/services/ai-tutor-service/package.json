{
  "name": "ai-tutor-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "eval:prompt": "tsx scripts/evaluatePrompt.ts",
    "compare:models": "tsx scripts/compareModels.ts",
    "smoke:contract": "tsx scripts/contractSmoke.ts",
    "e2e:gateway": "tsx scripts/e2eGateway.ts",
    "materials:seed": "tsx scripts/seedStudyMaterials.ts"
  },
  "dependencies": {
    "@google/genai": "^3.3.0",
    "@prisma/client": "^5.22.0",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "prisma": "^5.22.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
