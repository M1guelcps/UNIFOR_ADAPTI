# Opcional: MINIMAL | LOW | MEDIUM | HIGH. Só para modelos que aceitam thinkingLevel (vazio = padrão do modelo).
GEMINI_THINKING_LEVEL=
# Chamadas simultâneas ao Gemini; acima disso os pedidos esperam e, com a fila cheia, recebem 429.
GEMINI_MAX_CONCURRENCY=4
INTERNAL_API_KEY=
