PORT=3005
DATABASE_URL=
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_TIMEOUT_MS=25000
# Opcional: modelo usado na nova tentativa quando o principal responde 5xx (vazio = repete o principal).
